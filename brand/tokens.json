{
  "name": "Xenoglyphiq",
  "tagline": "Lost nothing in translation",
  "version": "1.0.0",
  "geometry": {
    "_note": "Mark units. One hexagon, pointy-top, repeated on a diagonal. Back copies sit up-right, the front copy sits down-left.",
    "hex_radius": 28,
    "step": 16,
    "stroke": 4,
    "linejoin": "round",
    "mark_viewbox": [
      -48,
      -48,
      96,
      96
    ],
    "mark_count": 3,
    "small": {
      "_note": "Optical cut for icons rendered at 64px and below: heavier stroke, slightly smaller hexes, tighter step so it still fits the same box.",
      "max_px": 64,
      "hex_radius": 26,
      "step": 14,
      "stroke": 7
    },
    "display_chain": {
      "_note": "Extended chains (4+ hexes) are for large surfaces only: banners, social images, hero art. Same step ratio as the mark (step = 0.5714 x radius). Stroke is lighter at display size (0.0696 x radius).",
      "step_ratio": 0.5714,
      "stroke_ratio": 0.0696,
      "min_count": 4
    },
    "tiny": {
      "_note": "Favicon cut for 24px and below: two hexes (the front pair), heavier stroke. Three outlines blur together at this size.",
      "max_px": 24,
      "count": 2,
      "hex_radius": 30,
      "step": 18,
      "stroke": 10
    },
    "mono_weave": {
      "_note": "One-color versions: each hex hides everything behind it, with a gap of gap_ratio x stroke, so the stack reads as layers without color.",
      "gap_ratio": 0.9
    }
  },
  "color": {
    "ember": {
      "amber": "#F6C177",
      "rose": "#EB6F92",
      "wine": "#8E2A55"
    },
    "ember_4": [
      "#F6C177",
      "#F0907F",
      "#D9507F",
      "#8E2A55"
    ],
    "neutral": {
      "ink": "#1E1A1C",
      "ink_soft": "#6B5F64",
      "paper": "#FAF7F5",
      "night": "#1C1117",
      "on_night": "#F7EDEF",
      "on_night_soft": "#C9A9B6",
      "white": "#FFFFFF"
    },
    "order": {
      "_note": "Listed back to front. On light backgrounds the darkest copy is in front; on dark backgrounds the order flips so the brightest copy is in front.",
      "light_bg": [
        "amber",
        "rose",
        "wine"
      ],
      "dark_bg": [
        "wine",
        "rose",
        "amber"
      ]
    }
  },
  "type": {
    "family": "Chakra Petch",
    "license": "SIL Open Font License 1.1",
    "wordmark": {
      "file": "fonts/ChakraPetch-Medium.ttf",
      "weight": 500
    },
    "tagline": {
      "file": "fonts/ChakraPetch-Regular.ttf",
      "weight": 400
    },
    "ui_bold": {
      "file": "fonts/ChakraPetch-SemiBold.ttf",
      "weight": 600
    },
    "case": "Title case wordmark (Xenoglyphiq), sentence case tagline",
    "font_synthesis": "none"
  },
  "lockups": {
    "_note": "All values are multiples of the wordmark font size F.",
    "primary": {
      "label": "A - horizontal",
      "mark_box": 1.7,
      "gap": 0.4,
      "tagline_size": 0.41,
      "tagline_baseline": 0.62,
      "padding": 0.2
    },
    "compact": {
      "label": "F - compact, no tagline",
      "mark_box": 1.5,
      "gap": 0.42,
      "padding": 0.2
    },
    "stacked": {
      "label": "C - stacked (backup)",
      "mark_box": 2.0,
      "gap": 0.22,
      "tagline_size": 0.44,
      "tagline_baseline": 0.62,
      "padding": 0.2
    }
  },
  "banners": {
